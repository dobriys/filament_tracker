# --- Database ---
POSTGRES_USER=filament
POSTGRES_PASSWORD=filament
POSTGRES_DB=filament_tracker
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Backend ---
# SECRET_KEY и ENCRYPTION_KEY НЕОБЯЗАТЕЛЬНЫ: если оставить пустыми, приложение
# сгенерирует их при первом старте и сохранит в БД (стабильно между рестартами).
# Задайте явно, только если хотите держать ключи вне БД. Сгенерировать вручную:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=

# --- Адреса (обычно менять НЕ нужно) ---
# По умолчанию всё определяется автоматически по адресу в браузере:
# открыли http://192.168.0.200:5173 — API и QR-коды сами возьмут этот адрес.
# Заполняйте только если стоите за reverse-proxy / доменом.

# CORS (через запятую; * — любой адрес, безопасно: авторизация без кук)
CORS_ORIGINS=*

# Базовый URL фронтенда для QR-кодов (пусто = автоматически по запросу)
FRONTEND_BASE_URL=

# Адрес API для фронтенда (пусто = хост из адресной строки, порт 8000)
VITE_API_BASE_URL=

# Интервал фонового опроса Moonraker-принтеров, сек (воркер)
MOONRAKER_POLL_INTERVAL=30
